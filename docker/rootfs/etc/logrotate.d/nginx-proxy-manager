/home/container/data/logs/*_access.log /home/container/data/logs/*/access.log {
    create 0644
    weekly
    rotate 4
    missingok
    notifempty
    compress
    sharedscripts
    postrotate
    kill -USR1 `cat /home/container/run/nginx/nginx.pid 2>/dev/null` 2>/dev/null || true
    endscript
}

/home/container/data/logs/*_error.log /home/container/data/logs/*/error.log {
    create 0644
    weekly
    rotate 10
    missingok
    notifempty
    compress
    sharedscripts
    postrotate
    kill -USR1 `cat /home/container/run/nginx/nginx.pid 2>/dev/null` 2>/dev/null || true
    endscript
}
